# Build outputs
**/build*/
*.a
*.o
*.so
*.so.*
*.dll
*.exe

# CMake presets (auto-generated by Conan)
**/CMakeUserPresets.json

# Python
*.pyc

# Editor temporaries
*~
*.swp
.DS_Store
.directory

# CMake / Ninja generated files
compile_commands.json
lint_output.txt
.lint_cache

# test_package — Conan regenerates these on every `conan create`
test_package/build/
test_package/conanbuild.sh
test_package/conanrun.sh
test_package/conanbuildenv-*.sh
test_package/conanrunenv-*.sh
test_package/deactivate_conanbuild.sh
test_package/deactivate_conanrun.sh
test_package/deactivate_conanbuildenv-*.sh
test_package/deactivate_conanrunenv-*.sh
test_package/metadata/

# Conan local cache (only profiles/ and global.conf are tracked)
.conan2/**
!.conan2/profiles/
!.conan2/profiles/**
!.conan2/global.conf

# The desk default of scripts/spec_conformance_gate.sh, and the artifact golden.yaml's compare
# job writes. There is no committed golden by design (it is the per-release agreed digest, so it
# cannot go stale) — an emitted one must never re-enter git.
/determinism-golden.txt

# The red-only dump tests/operations/test_golden_vectors.cpp writes beside a golden it could not
# match (`<corpus>.vectors.jsonl.actual`). It is a diagnostic for a HUMAN to diff, never the
# expectation — a dump that could re-enter git as a golden is a golden regenerated by accident.
tests/vectors/*.actual

# Benchmark outputs are ephemeral; the published baseline lives in coderoast-hub (single source
# of truth). A regenerated baseline.json must NOT re-enter git — no negation.
bench_results/

# VS Code / qtcreator
/.vscode/
**/.qmlls.ini
*.pro.user*

# Environment files (secrets)
.env
.env.local
.env.*.local
