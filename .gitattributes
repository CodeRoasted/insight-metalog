# Enforce LF line endings across the entire repository
* text=auto eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cmake text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf

# Explicitly binary files
*.o binary
*.a binary
*.so binary
*.exe binary
*.dll binary
*.ninja binary

# Byte-exact reference data — never eol-normalize (corpora/goldens/fixtures
# carry intentional CRLF / NUL / ANSI; a Windows checkout must preserve them verbatim).
scripts/determinism_corpus/** -text
# The golden vectors are the same species one step downstream: the EXPECTED wire bytes of
# compose()/diff() over that corpus. A test that byte-compares them cannot survive an
# eol-normalizing checkout, and `*.json text eol=lf` above would otherwise reach the
# `.jsonl` records through `* text=auto`.
tests/vectors/** -text
